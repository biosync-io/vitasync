{
  "name": "@biosync-io/saga",
  "version": "0.1.0",
  "description": "Saga orchestrator for multi-step distributed workflows in VitaSync",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "test": "node --import tsx/esm --test src/__tests__/saga.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3"
  },
  "license": "AGPL-3.0"
}
